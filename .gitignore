.cache/
.npm/
.eslintcache

# Optional REPL history
.node_repl_history

# External vendor resources for Electron app
static/vendor/
static/vendor/**

# Authentication files with sensitive information
annzarro/server/users.json
/data
auth/*.json
.auth/
*.auth
config/auth/*.json
# Generated login cookie key (annzarro/server/secret_key.py)
annzarro_secret_key
# Lock file guarding users.json writes (annzarro/server/auth.py)
*.json.lock
# Keep the config/auth directory, but not its contents
!config/auth/.gitkeep
annzarro/desktop/downloads/

# The committed test fixtures are AnnData stores whose members share names
# with directories ignored above (var/, data/). Without these, var/ and X/data/
# were silently left out of them and every test reading genes or X failed.
!annzarro/tests/data/fixture_small.zarr/var/
!annzarro/tests/data/fixture_small.zarr/X/data/
!annzarro/tests/data/fixture_small_v3.zarr/var/
!annzarro/tests/data/fixture_small_v3.zarr/X/data/

# Docs sources live under docs/; only top-level data dirs are local data.
!docs/data/
!docs/_static/screens/data/
