{
  "name": "annzarro-desktop",
  "productName": "AnnZarro",
  "version": "0.4.2",
  "description": "AnnZarro desktop app: the AnnZarro single-cell viewer with its server bundled",
  "main": "main.js",
  "author": {
    "name": "Setty Lab",
    "email": "dotto@fredhutch.org"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/settylab/annzarro.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --publish never",
    "dist:dir": "electron-builder --dir --publish never",
    "postinstall": "install-electron"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0"
  },
  "dependencies": {
    "electron-log": "^5.4.4"
  },
  "build": {
    "appId": "com.annzarro.desktop",
    "productName": "AnnZarro",
    "compression": "maximum",
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "loading.html",
      "error.html",
      "icons/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server/annzarro-server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../../LICENSE",
        "to": "LICENSE"
      }
    ],
    "artifactName": "AnnZarro-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icons/icon.icns",
      "darkModeSupport": true,
      "extraResources": [
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "LICENSE.electron.txt"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "LICENSES.chromium.html"
        },
        {
          "from": "licenses/macos-frameworks.txt",
          "to": "LICENSES.macos-frameworks.txt"
        }
      ],
      "artifactName": "AnnZarro-${version}-macos-${arch}.${ext}",
      "hardenedRuntime": true,
      "notarize": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "identity": "-"
    },
    "dmg": {
      "background": null,
      "iconSize": 100,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 150
        },
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "icons/icon.ico",
      "artifactName": "AnnZarro-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "AnnZarro-${version}-windows-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "icon": "icons",
      "synopsis": "Viewer for single-cell AnnData stored as zarr or h5ad",
      "maintainer": "Dominik Otto <dotto@fredhutch.org>",
      "artifactName": "AnnZarro-${version}-linux-${arch}.${ext}"
    },
    "publish": null
  },
  "homepage": "https://github.com/settylab/annzarro"
}
