{
  "name": "annzarro-desktop",
  "version": "0.1.0",
  "description": "Desktop application for Annzarro",
  "main": "main.js",
  "author": "Annzarro Contributors",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/settylab/annzarro.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-log": "^5.0.0",
    "electron-updater": "^6.1.1",
    "find-process": "^1.4.7"
  },
  "build": {
    "appId": "com.annzarro.desktop",
    "productName": "AnnZarro",
    "directories": {
      "output": "dist"
    },
    "publish": false,
    "files": [
      "**/*",
      "requirements.txt",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/.bin",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,__pycache__,thumbs.db,.gitignore,.gitattributes,.editorconfig,.idea,appveyor.yml,.travis.yml,circle.yml,npm-debug.log,.nyc_output,yarn.lock,yarn-error.log}"
    ],
    "asarUnpack": [
      "requirements.txt",
      "bin/${os}-${arch}/**/*",
      "python/**/*"
    ],
    "extraFiles": [
      {
        "from": "bin/${os}-${arch}",
        "to": "bin/${os}-${arch}",
        "filter": ["**/*"]
      }
    ],
    "extraResources": [
      {
        "from": "../../../",
        "to": "app",
        "filter": [
          "annzarro/**/*.py",
          "annzarro/**/__init__.py",
          "annzarro/data/**/*",
          "annzarro/bin/**/*",
          "annzarro/core/**/*",
          "annzarro/server/**/*",
          "annzarro/utils/**/*",
          "annzarro/desktop/**/*",
          "annzarro/ui/**/*",
          "requirements.txt",
          "annzarro-install.py",
          "annzarro-cli",
          "pyproject.toml",
          "setup.py",
          "config/**/*.yaml",
          "css/**/*.css",
          "js/**/*.js",
          "templates/**/*.html",
          "static/**/*",
          "!**/node_modules/**/*",
          "!**/.git/**/*",
          "!data/**",
          "!config/auth/**/*",
          "!**/downloads/**/*",
          "!**/venv/**/*",
          "!**/desktop/electron/dist/**/*",
          "!**/desktop/electron/node_modules/**/*",
          "!**/desktop/electron/python/**/*",
          "!**/logs/**/*",
          "!**/__pycache__/**/*",
          "!**/.pytest_cache/**/*",
          "!**/.ipynb_checkpoints/**/*",
          "!**/prototype_notebooks/**/*",
          "!**/tests/**/*"
        ]
      },
      {
        "from": "python",
        "to": "python",
        "filter": ["**/*"]
      }
    ],
    "mac": {
      "category": "public.app-category.science",
      "target": ["dmg", "zip"],
      "icon": "icons/icon.icns"
    },
    "win": {
      "target": ["nsis"],
      "icon": "icons/icon.ico"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Science",
      "icon": "icons"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}
