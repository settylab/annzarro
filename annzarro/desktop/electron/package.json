{
  "name": "annzarro-desktop",
  "productName": "AnnZarro",
  "version": "0.5.1",
  "description": "AnnZarro desktop app: the AnnZarro single-cell viewer with its server bundled",
  "main": "main.js",
  "author": {
    "name": "Setty Lab",
    "email": "dotto@fredhutch.org"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/settylab/annzarro.git"
  },
  "scripts": {
    "start": "electron .",
    "dist": "node ../scripts/electron_build.js",
    "dist:dir": "node ../scripts/electron_build.js --dir",
    "postinstall": "install-electron"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0"
  },
  "dependencies": {
    "electron-log": "^5.4.4",
    "electron-updater": "^6.8.9"
  },
  "build": {
    "appId": "com.annzarro.desktop",
    "productName": "AnnZarro",
    "compression": "maximum",
    "asar": true,
    "electronLanguages": [
      "en-US"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "updates.js",
      "update-logic.js",
      "window-chrome.js",
      "dataset-open.js",
      "dataset-open-logic.js",
      "preload.js",
      "loading.html",
      "error.html",
      "icons/**/*",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": "h5ad",
        "name": "AnnData h5ad file",
        "description": "AnnData h5ad file",
        "mimeType": "application/x-anndata-h5ad",
        "role": "Viewer"
      }
    ],
    "extraResources": [
      {
        "from": "server/annzarro-server",
        "to": "server",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../../../LICENSE",
        "to": "LICENSE"
      }
    ],
    "artifactName": "AnnZarro-${version}-${os}-${arch}.${ext}",
    "mac": {
      "category": "public.app-category.education",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "icons/icon.icns",
      "darkModeSupport": true,
      "extraResources": [
        {
          "from": "node_modules/electron/dist/LICENSE",
          "to": "LICENSE.electron.txt"
        },
        {
          "from": "node_modules/electron/dist/LICENSES.chromium.html",
          "to": "LICENSES.chromium.html"
        },
        {
          "from": "licenses/macos-frameworks.txt",
          "to": "LICENSES.macos-frameworks.txt"
        }
      ],
      "artifactName": "AnnZarro-${version}-macos-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Zarr store (folder)",
            "CFBundleTypeRole": "Viewer",
            "LSHandlerRank": "Default",
            "LSItemContentTypes": [
              "com.annzarro.zarr-store"
            ],
            "LSTypeIsPackage": false
          }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.annzarro.zarr-store",
            "UTTypeDescription": "Zarr store",
            "UTTypeConformsTo": [
              "public.folder"
            ],
            "UTTypeTagSpecification": {
              "public.filename-extension": [
                "zarr"
              ]
            }
          }
        ]
      }
    },
    "dmg": {
      "background": null,
      "iconSize": 100,
      "window": {
        "width": 540,
        "height": 380
      },
      "contents": [
        {
          "x": 130,
          "y": 150
        },
        {
          "x": 410,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "icons/icon.ico",
      "artifactName": "AnnZarro-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "AnnZarro-${version}-windows-${arch}-setup.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Science",
      "icon": "icons",
      "synopsis": "Viewer for single-cell AnnData stored as zarr or h5ad",
      "maintainer": "Dominik Otto <dotto@fredhutch.org>",
      "artifactName": "AnnZarro-${version}-linux-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "settylab",
        "repo": "annzarro",
        "releaseType": "release"
      }
    ]
  },
  "homepage": "https://github.com/settylab/annzarro"
}
