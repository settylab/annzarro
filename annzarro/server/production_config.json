{
  "host": "127.0.0.1",
  "port": 8000,
  "debug": false,
  "cors_enabled": true,
  "cors_origins": "*",
  "https_enabled": false,
  "cert_file": null,
  "key_file": null,
  "data_dir": "/opt/annzarro/data",
  "static_dir": "/opt/annzarro",
  "log_file": "/var/log/annzarro/server.log",
