#!/usr/bin/env bash
# Wrapper script for annzarro CLI that handles virtual environment activation

# Find the directory containing this script
DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" && pwd )"

# Default virtual environment path
VENV_PATH="$DIR/venv"

# Check for --venv-path argument and extract it if present
for ((i=1; i<=$#; i++)); do
    if [[ "${!i}" == "--venv-path" ]]; then
        j=$((i+1))
        if [[ $j -le $# ]]; then
            # Found a --venv-path argument, use its value
            VENV_PATH="${!j}"
            echo "Using custom virtual environment path: $VENV_PATH"
        fi
    fi
done

# Check if virtual environment exists
if [ -d "$VENV_PATH" ]; then
    # Determine activation script based on platform
    if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "win32" ]]; then
        # Windows
        ACTIVATE_SCRIPT="$VENV_PATH/Scripts/activate"
        PYTHON_BIN="$VENV_PATH/Scripts/python.exe"
    else
        # Unix-like
        ACTIVATE_SCRIPT="$VENV_PATH/bin/activate"
        PYTHON_BIN="$VENV_PATH/bin/python"
    fi
    
    # Special handling for install command to avoid circular dependencies
    if [ "$1" == "install" ]; then
        # For install command, we use the Python interpreter directly
        echo "Initializing AnnZarro installation..."
        echo "This will install dependencies needed for AnnZarro to run."
        
        INSTALLER_SCRIPT="$DIR/annzarro-install.py"
        if [ ! -f "$INSTALLER_SCRIPT" ]; then
            echo "Error: Standalone installer script not found: $INSTALLER_SCRIPT"
            exit 1
        fi
        
        # Launch the installer with arguments
        ARGS=()
        SKIP_NEXT=false
        
        # Process all arguments except the first one (install)
        for ((i=2; i<=$#; i++)); do
            if $SKIP_NEXT; then
                SKIP_NEXT=false
                continue
            fi
            
            # Skip the --venv-path argument and its value since we handle it separately
            if [[ "${!i}" == "--venv-path" ]]; then
                SKIP_NEXT=true
                continue
            fi
            
            ARGS+=("${!i}")
        done
        
        # Add the venv path to the arguments explicitly
        ARGS+=("--venv-path" "$VENV_PATH")
        
        # Handle actual cleaning before running the installer
        if [[ " ${ARGS[@]} " =~ " --clean " ]]; then
            echo "Cleaning up existing virtual environment..."
            rm -rf "$VENV_PATH"

            # Also clean UV binaries to force re-download
            echo "Cleaning UV binaries..."
            rm -rf "$DIR/annzarro/desktop/electron/bin"

            echo "Virtual environment and UV removed."
            
            # After cleaning, redirect to bootstrap script since no venv exists
            echo "Redirecting to bootstrap script for fresh installation..."
            BOOTSTRAP_SCRIPT="$DIR/annzarro/bin/bootstrap.sh"
            if [ ! -f "$BOOTSTRAP_SCRIPT" ]; then
                echo "Error: Bootstrap script not found at $BOOTSTRAP_SCRIPT"
                exit 1
            fi
            
            # Run the bootstrap script with the processed arguments
            echo -e "\nRunning bootstrap script: $BOOTSTRAP_SCRIPT ${ARGS[@]}\n"
            chmod +x "$BOOTSTRAP_SCRIPT"
            "$BOOTSTRAP_SCRIPT" "${ARGS[@]}"
            exit $?
        # Add --clean if not specified and not using --no-venv
        elif [[ ! " ${ARGS[@]} " =~ " --no-venv " ]]; then
            ARGS+=("--clean")
        fi
        
        # Try to find UV binary first - make it globally accessible for use later
        UV_CMD=""
        UV_EXT=""
        
        # Determine platform
        if [[ "$OSTYPE" == "darwin"* ]]; then
            # MacOS
            if [[ $(uname -m) == "arm64" ]]; then
                UV_PLATFORM_DIR="darwin-arm64"
            else
                UV_PLATFORM_DIR="darwin-x64"
            fi
        elif [[ "$OSTYPE" == "msys" || "$OSTYPE" == "win32" ]]; then
            # Windows
            UV_PLATFORM_DIR="win32-x64"
            UV_EXT=".exe"
        elif [[ "$OSTYPE" == "linux"* ]]; then
            # Linux
            UV_PLATFORM_DIR="linux-x64"
        fi
        
        # Check for UV in different bundled locations
        BUNDLED_UV="$DIR/annzarro/desktop/electron/bin/$UV_PLATFORM_DIR/uv$UV_EXT"
        echo "Checking for UV at: $BUNDLED_UV"
        
        if [ -f "$BUNDLED_UV" ]; then
            # Make executable on Unix platforms
            if [[ "$OSTYPE" != "msys" && "$OSTYPE" != "win32" ]]; then
                chmod +x "$BUNDLED_UV"
            fi
            UV_CMD="$BUNDLED_UV"
            echo "Found bundled UV at $BUNDLED_UV"
        else
            # Try other locations
            ALTERNATIVE_UV="$DIR/annzarro/desktop/bin/$UV_PLATFORM_DIR/uv$UV_EXT"
            echo "Checking for UV at alternative location: $ALTERNATIVE_UV"
            
            if [ -f "$ALTERNATIVE_UV" ]; then
                # Make executable on Unix platforms
                if [[ "$OSTYPE" != "msys" && "$OSTYPE" != "win32" ]]; then
                    chmod +x "$ALTERNATIVE_UV"
                fi
                UV_CMD="$ALTERNATIVE_UV"
                echo "Found bundled UV at $ALTERNATIVE_UV"
            fi
        fi
        
        # If bundled UV not found, try to download it
        if [ -z "$UV_CMD" ]; then
            if command -v uv &> /dev/null; then
                UV_CMD="uv"
                echo "Using system UV"
            else
                echo "UV not found in bundled locations, attempting to download..."
                UV_DOWNLOAD_SCRIPT="$DIR/annzarro/desktop/scripts/download_uv.sh"
                
                if [ -f "$UV_DOWNLOAD_SCRIPT" ]; then
                    echo "Running UV download script: $UV_DOWNLOAD_SCRIPT"
                    chmod +x "$UV_DOWNLOAD_SCRIPT"
                    
                    # Check for platform selection in args
                    DOWNLOAD_ARGS=()
                    if [[ " ${ARGS[@]} " =~ " --all-platforms " ]]; then
                        DOWNLOAD_ARGS+=("--all-platforms")
                    elif [[ " ${ARGS[@]} " =~ " --platform=" ]]; then
                        for arg in "${ARGS[@]}"; do
                            if [[ "$arg" == --platform=* ]]; then
                                DOWNLOAD_ARGS+=("$arg")
                                break
                            fi
                        done
                    elif [[ " ${ARGS[@]} " =~ " --platform " ]]; then
                        PLATFORM_INDEX=-1
                        for i in "${!ARGS[@]}"; do
                            if [[ "${ARGS[$i]}" == "--platform" ]]; then
                                PLATFORM_INDEX=$i
                                break
                            fi
                        done
                        if [[ $PLATFORM_INDEX -ge 0 ]] && [[ $((PLATFORM_INDEX+1)) -lt ${#ARGS[@]} ]]; then
                            DOWNLOAD_ARGS+=("--platform=${ARGS[$((PLATFORM_INDEX+1))]}")
                        fi
                    fi
                    
                    # Execute the download script with appropriate args
                    "$UV_DOWNLOAD_SCRIPT" "${DOWNLOAD_ARGS[@]}"
                    
                    # Check if download succeeded
                    BUNDLED_UV="$DIR/annzarro/desktop/electron/bin/$UV_PLATFORM_DIR/uv$UV_EXT"
                    if [ -f "$BUNDLED_UV" ]; then
                        chmod +x "$BUNDLED_UV"
                        UV_CMD="$BUNDLED_UV"
                        echo "Successfully downloaded UV to $BUNDLED_UV"
                    else
                        echo "Failed to download UV, falling back to pip"
                    fi
                else
                    echo "UV download script not found, falling back to pip"
                fi
            fi
        fi
        
        # Always download external resources for electron app by default
        echo "Will download external resources for Electron app (included by default)"
        # Use the correct flag that matches the installer script
        ARGS+=("--all")
        
        # If UV was found, create venv first with custom Python if specified, then use venv Python to run installer
        if [ -n "$UV_CMD" ]; then
            ARGS+=("--use-uv")
            ARGS+=("--uv-path" "$UV_CMD")
            
            # Check if --python and --python-env are specified in arguments
            CUSTOM_PYTHON=""
            PYTHON_ENV_VARS=()
            
            for ((i=0; i<${#ARGS[@]}; i++)); do
                if [[ "${ARGS[$i]}" == "--python" ]]; then
                    if [[ $((i+1)) -lt ${#ARGS[@]} ]]; then
                        CUSTOM_PYTHON="${ARGS[$((i+1))]}"
                        echo "Using custom Python for virtual environment: $CUSTOM_PYTHON"
                    fi
                elif [[ "${ARGS[$i]}" == "--python-env" ]]; then
                    if [[ $((i+1)) -lt ${#ARGS[@]} ]]; then
                        PYTHON_ENV_VARS+=("${ARGS[$((i+1))]}")
                        echo "Adding Python environment variable: ${ARGS[$((i+1))]}"
                    fi
                fi
            done
            
            # Set up environment variables for UV command
            UV_ENV=()
            if [[ ${#PYTHON_ENV_VARS[@]} -gt 0 ]]; then
                for env_var in "${PYTHON_ENV_VARS[@]}"; do
                    UV_ENV+=("$env_var")
                done
            fi
            
            # Create virtual environment with UV first
            echo "Creating virtual environment with UV..."
            if [[ -n "$CUSTOM_PYTHON" ]]; then
                echo "Using custom Python: $CUSTOM_PYTHON"
                if [[ ${#UV_ENV[@]} -gt 0 ]]; then
                    env "${UV_ENV[@]}" "$UV_CMD" venv "$VENV_PATH" --python "$CUSTOM_PYTHON"
                else
                    "$UV_CMD" venv "$VENV_PATH" --python "$CUSTOM_PYTHON"
                fi
            else
                if [[ ${#UV_ENV[@]} -gt 0 ]]; then
                    env "${UV_ENV[@]}" "$UV_CMD" venv "$VENV_PATH"
                else
                    "$UV_CMD" venv "$VENV_PATH"
                fi
            fi
            
            # Check if venv creation was successful
            if [ $? -ne 0 ]; then
                echo "Failed to create virtual environment with UV"
                exit 1
            fi
            
            # Now use Python from the virtual environment to run the installer
            if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "win32" ]]; then
                VENV_PYTHON="$VENV_PATH/Scripts/python.exe"
            else
                VENV_PYTHON="$VENV_PATH/bin/python"
            fi
            
            if [ ! -f "$VENV_PYTHON" ]; then
                echo "Error: Python executable not found in virtual environment: $VENV_PYTHON"
                exit 1
            fi
            
            echo -e "\nExecuting: $VENV_PYTHON $INSTALLER_SCRIPT ${ARGS[@]} (with UV support)\n"
            if [[ ${#UV_ENV[@]} -gt 0 ]]; then
                env "${UV_ENV[@]}" "$VENV_PYTHON" "$INSTALLER_SCRIPT" "${ARGS[@]}"
            else
                "$VENV_PYTHON" "$INSTALLER_SCRIPT" "${ARGS[@]}"
            fi
            exit $?
        else
            # Fallback: Find the Python executable (try python3 first, then python)
            PYTHON_CMD="python3"
            if ! command -v $PYTHON_CMD &> /dev/null; then
                PYTHON_CMD="python"
                if ! command -v $PYTHON_CMD &> /dev/null; then
                    echo "Error: Neither python3 nor python commands were found on your system."
                    echo "Please install Python 3.7 or later and try again."
                    exit 1
                fi
            fi
            
            echo -e "\nExecuting: $PYTHON_CMD $INSTALLER_SCRIPT ${ARGS[@]}\n"
            "$PYTHON_CMD" "$INSTALLER_SCRIPT" "${ARGS[@]}"
            exit $?
        fi
    fi
    
    # For all other commands, directly use the Python from the virtual environment
    if [ -f "$PYTHON_BIN" ]; then
        # Filter out --venv-path and its value from arguments
        FILTERED_ARGS=()
        SKIP_NEXT=false
        
        for ((i=1; i<=$#; i++)); do
            if $SKIP_NEXT; then
                SKIP_NEXT=false
                continue
            fi
            
            if [[ "${!i}" == "--venv-path" ]]; then
                SKIP_NEXT=true
                continue
            fi
            FILTERED_ARGS+=("${!i}")
        done
        
        # If we have UV, we can use it instead of the system Python to ensure a clean environment
        if [ -n "$UV_CMD" ]; then
            echo "Using UV to run AnnZarro in virtual environment"
            "$UV_CMD" run -p "$VENV_PATH" -m annzarro.cli "${FILTERED_ARGS[@]}"
        else
            # Use Python directly from the virtual environment with filtered arguments
            "$PYTHON_BIN" -m annzarro.cli "${FILTERED_ARGS[@]}"
        fi
    else
        echo "Warning: Python executable not found in virtual environment at $PYTHON_BIN"
        echo "Try reinstalling with: $0 install --clean"
        exit 1
    fi
else
    # Check if using system Python is explicitly requested
    if [[ "$*" == *"--no-venv"* ]]; then
        # Find the Python executable (try python3 first, then python)
        PYTHON_CMD="python3"
        if ! command -v $PYTHON_CMD &> /dev/null; then
            PYTHON_CMD="python"
            if ! command -v $PYTHON_CMD &> /dev/null; then
                echo "Error: Neither python3 nor python commands were found on your system."
                echo "Please install Python 3.7 or later and try again."
                exit 1
            fi
        fi
        
        # Filter out --no-venv from arguments
        FILTERED_ARGS=()
        for ((i=1; i<=$#; i++)); do
            if [[ "${!i}" != "--no-venv" ]]; then
                FILTERED_ARGS+=("${!i}")
            fi
        done
        
        echo "Using system Python without virtual environment"
        $PYTHON_CMD -m annzarro.cli "${FILTERED_ARGS[@]}"
        exit $?
    # Handle case where venv doesn't exist except for install command
    elif [ "$1" == "install" ]; then
        echo "Initializing AnnZarro installation..."
        echo "This will install dependencies needed for AnnZarro to run."

        # Use the bootstrap script to create a Python environment without requiring Python to be installed
        BOOTSTRAP_SCRIPT="$DIR/annzarro/bin/bootstrap.sh"
        if [ ! -f "$BOOTSTRAP_SCRIPT" ]; then
            echo "Error: Bootstrap script not found at $BOOTSTRAP_SCRIPT"
            exit 1
        fi
        
        # Process all arguments except the first one (install)
        ARGS=()
        SKIP_NEXT=false
        
        for ((i=2; i<=$#; i++)); do
            if $SKIP_NEXT; then
                SKIP_NEXT=false
                continue
            fi
            
            # Skip the --venv-path argument and its value since we handle it separately
            if [[ "${!i}" == "--venv-path" ]]; then
                SKIP_NEXT=true
                continue
            fi
            
            ARGS+=("${!i}")
        done
        
        # Add the venv path to the arguments explicitly
        ARGS+=("--venv-path" "$VENV_PATH")
        
        # Always download external resources for electron app by default
        echo "Will download external resources for Electron app (included by default)"
        ARGS+=("--all")
        
        # Run the bootstrap script with the processed arguments
        echo -e "\nRunning bootstrap script: $BOOTSTRAP_SCRIPT ${ARGS[@]}\n"
        chmod +x "$BOOTSTRAP_SCRIPT"
        "$BOOTSTRAP_SCRIPT" "${ARGS[@]}"
        exit $?
    else
        echo "Virtual environment not found. Please run installation first:"
        echo "$0 install"
        exit 1
    fi
fi